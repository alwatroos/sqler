{
  "Servers": {
    "1": {
      "Name": "Orders primary",
      "Group": "Shop",
      "Host": "db.example.test",
      "Port": 5433,
      "MaintenanceDB": "orders",
      "Username": "alice",
      "BGColor": "#AA3300",
      "FGColor": "#ffffff",
      "Comment": "main orders database",
      "Role": "readonly",
      "PassFile": "/home/alice/.pgpass",
      "ConnectionParameters": {
        "sslmode": "verify-full",
        "sslrootcert": "/home/alice/certs/ca.pem",
        "sslcert": "/home/alice/certs/client.pem",
        "sslkey": "/home/alice/certs/client.key",
        "connect_timeout": 10
      }
    },
    "2": {
      "Name": "Legacy staging",
      "Group": "Shop",
      "Host": "staging.example.test",
      "Port": "5432",
      "MaintenanceDB": "postgres",
      "Username": "bob",
      "SSLMode": "require",
      "SSLRootCert": "/home/alice/certs/ca.pem",
      "Timeout": 30
    },
    "3": {
      "Name": "Tunnelled with key",
      "Host": "10.0.0.5",
      "Username": "alice",
      "SSLMode": "allow",
      "UseSSHTunnel": 1,
      "TunnelHost": "bastion.example.test",
      "TunnelPort": 2222,
      "TunnelUsername": "tunnel",
      "TunnelAuthentication": 1,
      "TunnelIdentityFile": "/home/alice/.ssh/id_test"
    },
    "4": {
      "Name": "Tunnelled with password",
      "Host": "::1",
      "Username": "alice",
      "UseSSHTunnel": true,
      "TunnelHost": "bastion.example.test",
      "TunnelUsername": "tunnel",
      "TunnelAuthentication": 0
    },
    "5": {
      "Name": "Socket",
      "Host": "/var/run/postgresql",
      "Username": "carol",
      "SSLMode": "disable"
    },
    "6": {
      "Name": "Kerberos",
      "Host": "krb.example.test",
      "Username": "alice@EXAMPLE.TEST",
      "KerberosAuthentication": true
    },
    "7": {
      "Name": "By service",
      "Host": "",
      "Service": "svc_test"
    }
  }
}
